# Video Collector module configuration. All opt-ins are OFF by default.
# Copy selected settings to the EXISTING repo-root .env or your deployment
# secret store. Do not commit a populated .env file to any Git branch.
CM_DB_ENABLED=0
CM_COLLECTOR_QV_CONSUMER_ENABLED=0
CM_COLLECTOR_LIVE_ENABLED=0
CM_DTK_ARCHIVE_DISABLED_CONFIRMED=0
CM_COLLECTOR_SRE_DELIVERY_ENABLED=0

# Never put a real DSN, password, provider token or API key in this example.
# Provision CM_DB_DSN, CM_DTK_ENABLED, CM_DTK_BASE_URL and CM_DTK_API_KEY
# via your existing local-only configuration/secret store where authorized.
# Confirm current reviewed source policy, quota, no-charge rights and
# upstream archive settings separately before any provider release.
