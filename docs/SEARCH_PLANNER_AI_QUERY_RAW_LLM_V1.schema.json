{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BanSins7/ContentMachine/blob/main/docs/SEARCH_PLANNER_AI_QUERY_RAW_LLM_V1.schema.json",
  "title": "AI Query LLM raw batch response v1",
  "description": "Inspectable thinkqe/mugi/jina-inspired derived trace for each hypothesis in a batch. No server IDs or provenance in model output. Referential/scope invariants must be enforced by Python.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hypotheses"
  ],
  "properties": {
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "semantic_profile",
          "facets",
          "queries",
          "no_viable_reason"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,39}$"
          },
          "semantic_profile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "core_activity",
              "audience",
              "problem",
              "environment",
              "mandatory_constraints",
              "unknowns"
            ],
            "properties": {
              "core_activity": {
                "type": "string",
                "maxLength": 200
              },
              "audience": {
                "type": "string",
                "maxLength": 200
              },
              "problem": {
                "type": "string",
                "maxLength": 200
              },
              "environment": {
                "type": "string",
                "maxLength": 200
              },
              "mandatory_constraints": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "unknowns": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              }
            }
          },
          "facets": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "facet_key",
                "angle",
                "intent",
                "anchor_terms",
                "sketches",
                "lexical_hints"
              ],
              "properties": {
                "facet_key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,39}$"
                },
                "angle": {
                  "type": "string",
                  "enum": [
                    "direct",
                    "problem",
                    "solution",
                    "situation",
                    "format",
                    "comparison",
                    "experience",
                    "critical",
                    "other"
                  ]
                },
                "intent": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "anchor_terms": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "sketches": {
                  "type": "array",
                  "maxItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "lexical_hints": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 90
                  }
                }
              }
            }
          },
          "queries": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "facet_key",
                "text",
                "query_mode",
                "angle",
                "language",
                "research_stance",
                "rationale"
              ],
              "properties": {
                "facet_key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,39}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "query_mode": {
                  "enum": [
                    "keyword",
                    "hashtag"
                  ]
                },
                "angle": {
                  "enum": [
                    "direct",
                    "problem",
                    "solution",
                    "situation",
                    "format",
                    "comparison",
                    "experience",
                    "critical",
                    "other"
                  ]
                },
                "language": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
                },
                "research_stance": {
                  "enum": [
                    "support",
                    "challenge",
                    "neutral"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 280
                }
              }
            }
          },
          "no_viable_reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 280
          }
        }
      }
    }
  }
}
