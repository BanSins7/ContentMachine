{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentMachine Query Validation → Task Planner handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validation_run_id",
    "generation_id",
    "project_id",
    "embedding_model_key",
    "embedding_mode",
    "config_sha256",
    "source_bundle_sha256",
    "status",
    "queries",
    "coverage",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": "validated_queries/v1"
    },
    "validation_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "generation_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "embedding_model_key": {
      "type": "string",
      "minLength": 1
    },
    "embedding_mode": {
      "enum": [
        "semantic_local",
        "test_fixture"
      ]
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "const": "completed"
    },
    "queries": {
      "type": "array",
      "maxItems": 480,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "hypothesis_id",
          "direction_id",
          "branch_id",
          "source_fact_ids",
          "text",
          "query_mode",
          "angle",
          "language",
          "research_stance",
          "rationale",
          "relevance_score",
          "negative_score",
          "mmr_score",
          "rank_in_hypothesis"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "format": "uuid"
          },
          "hypothesis_id": {
            "type": "string"
          },
          "direction_id": {
            "type": "string"
          },
          "branch_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "query_mode": {
            "enum": [
              "keyword",
              "hashtag"
            ]
          },
          "angle": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "research_stance": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "relevance_score": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "negative_score": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "mmr_score": {
            "type": "number",
            "minimum": -2,
            "maximum": 2
          },
          "rank_in_hypothesis": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "source_count",
          "selected_count",
          "outcome",
          "reason"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string"
          },
          "source_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16
          },
          "selected_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16
          },
          "outcome": {
            "enum": [
              "selected",
              "no_source_candidates",
              "all_rejected"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 480,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "decision",
          "reason_code",
          "duplicate_of",
          "positive_similarity",
          "negative_similarity",
          "score_margin",
          "mmr_score"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "format": "uuid"
          },
          "decision": {
            "enum": [
              "selected",
              "rejected"
            ]
          },
          "reason_code": {
            "type": "string"
          },
          "duplicate_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "positive_similarity": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "negative_similarity": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "score_margin": {
            "type": "number",
            "minimum": -2,
            "maximum": 2
          },
          "mmr_score": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}
