{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:content-machine:search-planner:handoff-projection:v1",
  "title": "ContentMachine Search Planner DB-verified QV handoff projection V1",
  "description": "Informational/held-only. A self-checksummed JSON value is not proof of QV approval; server must reconstruct from PostgreSQL. Runtime also checks cross-chunk parity and every source link against QV.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "project_id",
    "validation_run_id",
    "qv_outbox_id",
    "generation_id",
    "taxonomy_publication_id",
    "taxonomy_version",
    "taxonomy_sha256",
    "generation_input_sha256",
    "qv_config_sha256",
    "qv_source_bundle_sha256",
    "embedding_model_key",
    "validated_bundle_sha256",
    "linked_provenance_sha256",
    "coverage",
    "coverage_sha256",
    "source_candidate_decision_count",
    "selected_query_count",
    "selected_query_ids",
    "chunk_capacity",
    "chunk_count",
    "chunks",
    "no_work_reason",
    "qv_outbox_acknowledged_by_this_projection",
    "collector_receipt",
    "external_dispatch_authorized",
    "provider_calls_in_this_projection",
    "projection_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "search-planner-handoff-projection/v1"
    },
    "status": {
      "enum": [
        "awaiting_sp_inbox",
        "no_work"
      ]
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "validation_run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "qv_outbox_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "generation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "taxonomy_publication_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "taxonomy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "taxonomy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qv_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qv_source_bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "embedding_model_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "validated_bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "linked_provenance_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "source_count",
          "selected_count",
          "outcome",
          "reason"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16
          },
          "selected_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16
          },
          "outcome": {
            "enum": [
              "selected",
              "no_source_candidates",
              "all_rejected"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "coverage_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_candidate_decision_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 480
    },
    "selected_query_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 480
    },
    "selected_query_ids": {
      "type": "array",
      "maxItems": 480,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    },
    "chunk_capacity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "chunk_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "chunks": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "chunk_index",
          "chunk_count",
          "chunk_size",
          "total_selected_count",
          "query_ids",
          "collector_query_set",
          "collector_query_set_sha256",
          "source_provenance",
          "chunk_sha256"
        ],
        "properties": {
          "schema_version": {
            "const": "search-planner-handoff-chunk/v1"
          },
          "chunk_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "chunk_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "chunk_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "total_selected_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 480
          },
          "query_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "uniqueItems": true
          },
          "collector_query_set": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema_version",
              "project_id",
              "taxonomy_publication_id",
              "taxonomy_version",
              "taxonomy_sha256",
              "generation_id",
              "validation_version",
              "queries"
            ],
            "properties": {
              "schema_version": {
                "const": "validated_query_set/v1"
              },
              "project_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "taxonomy_publication_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "taxonomy_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "taxonomy_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "generation_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "validation_version": {
                "const": "sp-qv-verified/v1"
              },
              "queries": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "query_id",
                    "hypothesis_id",
                    "direction_id",
                    "mode",
                    "text",
                    "language",
                    "validation_state"
                  ],
                  "properties": {
                    "query_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    "hypothesis_id": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 128
                    },
                    "direction_id": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 128
                    },
                    "mode": {
                      "enum": [
                        "keyword",
                        "hashtag"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "language": {
                      "type": "string",
                      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
                    },
                    "validation_state": {
                      "const": "accepted"
                    }
                  }
                }
              }
            }
          },
          "collector_query_set_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_provenance": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "query_id",
                "selected_candidate",
                "selected_decision",
                "linked_sources",
                "linked_qv_decisions"
              ],
              "properties": {
                "query_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "selected_candidate": {
                  "type": "object",
                  "required": [
                    "candidate_id",
                    "hypothesis_id",
                    "direction_id",
                    "source_fact_ids",
                    "text",
                    "query_mode",
                    "language",
                    "rank_in_hypothesis"
                  ],
                  "additionalProperties": true
                },
                "selected_decision": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "candidate_id",
                    "decision",
                    "reason_code",
                    "duplicate_of",
                    "positive_similarity",
                    "negative_similarity",
                    "score_margin",
                    "mmr_score"
                  ],
                  "properties": {
                    "candidate_id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    "decision": {
                      "enum": [
                        "selected",
                        "rejected"
                      ]
                    },
                    "reason_code": {
                      "enum": [
                        "selected",
                        "explicit_exclusion",
                        "low_relevance",
                        "negative_scope",
                        "exact_duplicate",
                        "semantic_duplicate",
                        "quota"
                      ]
                    },
                    "duplicate_of": {
                      "oneOf": [
                        {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "positive_similarity": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "negative_similarity": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "score_margin": {
                      "type": "number",
                      "minimum": -2,
                      "maximum": 2
                    },
                    "mmr_score": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                },
                "linked_sources": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 480,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "candidate_id",
                      "hypothesis_id",
                      "source_fact_ids"
                    ],
                    "properties": {
                      "candidate_id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "hypothesis_id": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 128
                      },
                      "source_fact_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "maxItems": 480,
                        "uniqueItems": true
                      }
                    }
                  }
                },
                "linked_qv_decisions": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 480,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "candidate_id",
                      "decision",
                      "reason_code",
                      "duplicate_of",
                      "positive_similarity",
                      "negative_similarity",
                      "score_margin",
                      "mmr_score"
                    ],
                    "properties": {
                      "candidate_id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "decision": {
                        "enum": [
                          "selected",
                          "rejected"
                        ]
                      },
                      "reason_code": {
                        "enum": [
                          "selected",
                          "explicit_exclusion",
                          "low_relevance",
                          "negative_scope",
                          "exact_duplicate",
                          "semantic_duplicate",
                          "quota"
                        ]
                      },
                      "duplicate_of": {
                        "oneOf": [
                          {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "positive_similarity": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "negative_similarity": {
                        "type": "number",
                        "minimum": -1,
                        "maximum": 1
                      },
                      "score_margin": {
                        "type": "number",
                        "minimum": -2,
                        "maximum": 2
                      },
                      "mmr_score": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "chunk_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "no_work_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "qv_outbox_acknowledged_by_this_projection": {
      "const": false
    },
    "collector_receipt": {
      "type": "null"
    },
    "external_dispatch_authorized": {
      "const": false
    },
    "provider_calls_in_this_projection": {
      "const": 0
    },
    "projection_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "no_work"
        },
        "selected_query_count": {
          "const": 0
        },
        "chunk_count": {
          "const": 0
        },
        "chunks": {
          "maxItems": 0
        },
        "selected_query_ids": {
          "maxItems": 0
        },
        "no_work_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "properties": {
        "status": {
          "const": "awaiting_sp_inbox"
        },
        "selected_query_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "chunk_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "chunks": {
          "minItems": 1
        },
        "no_work_reason": {
          "type": "null"
        }
      }
    }
  ]
}
