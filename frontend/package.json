{
  "name": "contentmachine-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsc --project tsconfig.legacy.json && vite",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build && tsc --project tsconfig.legacy.json && node scripts/verify-build.mjs",
    "verify": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
