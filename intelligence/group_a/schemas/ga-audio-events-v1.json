{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentmachine.local/schemas/group-a/ga-audio-events-v1.json",
  "title": "GA15 explicit multi-label audio events; model negatives remain unknown; A003 requires timebase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method_version",
    "source_media_sha256",
    "source_pcm_sha256",
    "source_stream_index",
    "state",
    "reason_code",
    "time_origin",
    "selected_audio_duration_ms",
    "music_presence",
    "sound_effect_presence",
    "other_presence",
    "audio_absence_verified",
    "classifier_model",
    "class_probability_calibrated",
    "full_video_acoustic_coverage",
    "window_coverage",
    "counts",
    "windows",
    "events",
    "video_duration_sec",
    "video_clock_offset_sec",
    "video_clock_state",
    "a003_audio_events_projection",
    "a003_mapping_state",
    "config",
    "observation_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "ga-audio-events/v1"
    },
    "method_version": {
      "const": "group-a-audio-events-local-v1"
    },
    "source_media_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_pcm_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_stream_index": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "no_audio_stream",
        "unavailable",
        "digital_silence",
        "classifier_unavailable",
        "classified_partial",
        "partial_failure"
      ]
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "time_origin": {
      "const": "audio_stream_local_zero"
    },
    "selected_audio_duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "music_presence": {
      "enum": [
        "true",
        "false",
        "unknown"
      ]
    },
    "sound_effect_presence": {
      "enum": [
        "true",
        "false",
        "unknown"
      ]
    },
    "other_presence": {
      "enum": [
        "true",
        "false",
        "unknown"
      ]
    },
    "audio_absence_verified": {
      "type": "boolean"
    },
    "classifier_model": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine",
            "engine_version",
            "model_version",
            "model_sha256",
            "labelmap_sha256",
            "device",
            "license_authorization"
          ],
          "properties": {
            "engine": {
              "enum": [
                "yamnet_onnx",
                "panns_onnx",
                "injected_offline"
              ]
            },
            "engine_version": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9._+\\-]{1,80}$"
            },
            "model_version": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9._+\\-]{1,80}$"
            },
            "model_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "labelmap_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "device": {
              "const": "cpu"
            },
            "license_authorization": {
              "const": "host_verified"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "class_probability_calibrated": {
      "const": false
    },
    "full_video_acoustic_coverage": {
      "const": false
    },
    "window_coverage": {
      "enum": [
        "complete_selected_pcm",
        "verified_absence",
        "partial_with_failures",
        "unknown"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "observed",
        "failed",
        "unavailable",
        "events"
      ],
      "properties": {
        "attempted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3000
        },
        "observed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3000
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3000
        },
        "unavailable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3000
        },
        "events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3000
        }
      }
    },
    "windows": {
      "type": "array",
      "maxItems": 3000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "window_index",
          "start_sample",
          "end_sample",
          "start_sec",
          "end_sec",
          "state",
          "scores",
          "reason_code"
        ],
        "properties": {
          "window_index": {
            "type": "integer",
            "minimum": 0
          },
          "start_sample": {
            "type": "integer",
            "minimum": 0
          },
          "end_sample": {
            "type": "integer",
            "minimum": 1
          },
          "start_sec": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
          },
          "end_sec": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
          },
          "state": {
            "enum": [
              "observed",
              "failed",
              "unavailable"
            ]
          },
          "scores": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "music",
                  "sound_effect",
                  "other"
                ],
                "properties": {
                  "music": {
                    "type": "string",
                    "pattern": "^(?:0\\.[0-9]{3}|1\\.000)$"
                  },
                  "sound_effect": {
                    "type": "string",
                    "pattern": "^(?:0\\.[0-9]{3}|1\\.000)$"
                  },
                  "other": {
                    "type": "string",
                    "pattern": "^(?:0\\.[0-9]{3}|1\\.000)$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,79}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "const": "observed"
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "properties": {
                "scores": {
                  "type": "object"
                },
                "reason_code": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "failed",
                    "unavailable"
                  ]
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "properties": {
                "scores": {
                  "type": "null"
                },
                "reason_code": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "events": {
      "type": "array",
      "maxItems": 3000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_type",
          "start_sec",
          "end_sec",
          "source_start_sample",
          "source_end_sample",
          "source_window_indices",
          "max_engine_score",
          "threshold",
          "evidence_level",
          "confidence_pct"
        ],
        "properties": {
          "event_type": {
            "enum": [
              "music",
              "sound_effect",
              "other"
            ]
          },
          "start_sec": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
          },
          "end_sec": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
          },
          "source_start_sample": {
            "type": "integer",
            "minimum": 0
          },
          "source_end_sample": {
            "type": "integer",
            "minimum": 1
          },
          "source_window_indices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3000,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "max_engine_score": {
            "type": "string",
            "pattern": "^(?:0\\.[0-9]{3}|1\\.000)$"
          },
          "threshold": {
            "type": "string",
            "pattern": "^(?:0\\.[0-9]{3}|1\\.000)$"
          },
          "evidence_level": {
            "const": "uncalibrated_local_model_candidate"
          },
          "confidence_pct": {
            "type": "null"
          }
        }
      }
    },
    "video_duration_sec": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "video_clock_offset_sec": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "video_clock_state": {
      "enum": [
        "video_clock_missing",
        "no_audio_stream",
        "stream_start_offset_unavailable",
        "ffprobe_audio_video_stream_origin"
      ]
    },
    "a003_audio_events_projection": {
      "type": "array",
      "maxItems": 3000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_type",
          "start_sec",
          "end_sec",
          "label",
          "method_name",
          "confidence_pct"
        ],
        "properties": {
          "event_type": {
            "enum": [
              "music",
              "sound_effect",
              "other"
            ]
          },
          "start_sec": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
          },
          "end_sec": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
          },
          "label": {
            "enum": [
              "music",
              "sound_effect",
              "other"
            ]
          },
          "method_name": {
            "const": "group-a-audio-events-local-v1"
          },
          "confidence_pct": {
            "type": "null"
          }
        }
      }
    },
    "a003_mapping_state": {
      "enum": [
        "blocked_no_events",
        "blocked_unverified_video_timebase",
        "verified_audio_video_timebase"
      ]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_ms",
        "hop_ms",
        "music_threshold",
        "sound_effect_threshold",
        "other_threshold",
        "min_positive_windows",
        "wallclock_budget_sec",
        "classifier_policy_version",
        "device"
      ],
      "properties": {
        "window_ms": {
          "enum": [
            250,
            500,
            1000
          ]
        },
        "hop_ms": {
          "enum": [
            125,
            250,
            500
          ]
        },
        "music_threshold": {
          "type": "string",
          "pattern": "^(?:0\\.[0-9]{3}|1\\.000)$"
        },
        "sound_effect_threshold": {
          "type": "string",
          "pattern": "^(?:0\\.[0-9]{3}|1\\.000)$"
        },
        "other_threshold": {
          "type": "string",
          "pattern": "^(?:0\\.[0-9]{3}|1\\.000)$"
        },
        "min_positive_windows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "wallclock_budget_sec": {
          "type": "integer",
          "minimum": 10,
          "maximum": 600
        },
        "classifier_policy_version": {
          "type": "string"
        },
        "device": {
          "const": "cpu"
        }
      }
    },
    "observation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "no_audio_stream",
              "digital_silence"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "audio_absence_verified": {
            "const": true
          },
          "music_presence": {
            "const": "false"
          },
          "sound_effect_presence": {
            "const": "false"
          },
          "other_presence": {
            "const": "false"
          },
          "events": {
            "maxItems": 0
          },
          "windows": {
            "maxItems": 0
          },
          "classifier_model": {
            "type": "null"
          },
          "window_coverage": {
            "const": "verified_absence"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "classifier_unavailable",
              "unavailable"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "audio_absence_verified": {
            "const": false
          },
          "music_presence": {
            "const": "unknown"
          },
          "sound_effect_presence": {
            "const": "unknown"
          },
          "events": {
            "maxItems": 0
          },
          "windows": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "classified_partial",
              "partial_failure"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "classifier_model": {
            "type": "object"
          },
          "audio_absence_verified": {
            "const": false
          },
          "music_presence": {
            "enum": [
              "true",
              "unknown"
            ]
          },
          "sound_effect_presence": {
            "enum": [
              "true",
              "unknown"
            ]
          },
          "other_presence": {
            "enum": [
              "true",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "a003_mapping_state": {
            "const": "blocked_no_events"
          }
        },
        "required": [
          "a003_mapping_state"
        ]
      },
      "then": {
        "properties": {
          "events": {
            "maxItems": 0
          },
          "a003_audio_events_projection": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "a003_mapping_state": {
            "const": "blocked_unverified_video_timebase"
          }
        },
        "required": [
          "a003_mapping_state"
        ]
      },
      "then": {
        "properties": {
          "a003_audio_events_projection": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "a003_mapping_state": {
            "const": "verified_audio_video_timebase"
          }
        },
        "required": [
          "a003_mapping_state"
        ]
      },
      "then": {
        "properties": {
          "video_duration_sec": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
          },
          "video_clock_offset_sec": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
          },
          "a003_audio_events_projection": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
