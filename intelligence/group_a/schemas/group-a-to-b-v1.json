{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable A facts handoff for semantic Group B",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "group-a-to-b/v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$",
      "minLength": 32,
      "maxLength": 32
    },
    "qdp_run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "video_id": {
      "type": "integer",
      "minimum": 1
    },
    "qdp_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "content_kind": {
      "enum": [
        "video",
        "slideshow_video",
        "photo_carousel",
        "mixed_carousel",
        "image_post"
      ]
    },
    "analysis_state": {
      "enum": [
        "partial",
        "completed"
      ]
    },
    "video_a_analysis_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "carousel_a_analysis_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "method_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "streams": {
      "type": "object",
      "additionalProperties": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Measured stream status with explicit absence semantics",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "not_run",
              "complete",
              "partial",
              "unavailable"
            ]
          },
          "evidence_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "verified_absence": {
            "type": "boolean"
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,79}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status",
          "evidence_count",
          "verified_absence",
          "reason_code"
        ],
        "$id": "https://contentmachine.local/schemas/group-a/stream-truth-v1.json",
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "complete"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "evidence_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "reason_code": {
                  "type": "null"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "evidence_count": {
                        "const": 0
                      }
                    },
                    "required": [
                      "evidence_count"
                    ]
                  },
                  "then": {
                    "properties": {
                      "verified_absence": {
                        "const": true
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "verified_absence": {
                        "const": false
                      }
                    }
                  }
                }
              ]
            },
            "else": {
              "properties": {
                "verified_absence": {
                  "const": false
                },
                "reason_code": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "not_run",
                    "unavailable"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "evidence_count": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "propertyNames": {
        "enum": [
          "technical",
          "speech",
          "screen_text",
          "audio",
          "subtitles",
          "slides"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "title": "Immutable proof pointer",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "scene",
              "transcript",
              "screen_text",
              "audio",
              "frame",
              "slide"
            ]
          },
          "ref_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "asset_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        },
        "required": [
          "kind",
          "ref_sha256",
          "asset_sha256"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "qdp_run_id",
    "video_id",
    "qdp_input_sha256",
    "manifest_sha256",
    "content_kind",
    "analysis_state",
    "video_a_analysis_id",
    "carousel_a_analysis_id",
    "method_version",
    "streams",
    "evidence"
  ],
  "$id": "https://contentmachine.local/schemas/group-a/group-a-to-b-v1.json"
}
