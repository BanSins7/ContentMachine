{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentmachine.local/schemas/group-a/group-a-receipt-v1.json",
  "title": "Committed durable Group A inbox receipt, not completed analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "event_id",
    "project_id",
    "qdp_run_id",
    "video_id",
    "run_id",
    "job_id",
    "payload_sha256",
    "replayed",
    "analysis_state"
  ],
  "properties": {
    "schema_version": {
      "const": "group-a-receipt/v1"
    },
    "state": {
      "const": "recorded"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "qdp_run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "video_id": {
      "type": "integer",
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "job_id": {
      "type": "integer",
      "minimum": 1
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replayed": {
      "type": "boolean"
    },
    "analysis_state": {
      "const": "not_started"
    }
  }
}
