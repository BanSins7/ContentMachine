{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentmachine.local/schemas/group-a/qdp-preparation-ready-v1.json",
  "title": "QDP group A preparation-ready event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pointer"
  ],
  "properties": {
    "schema_version": {
      "const": "qdp.preparation_ready/v1"
    },
    "pointer": {
      "title": "QDP A handoff (observed QDP-owned pointer)",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "qdp-handoff/v1"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$",
          "minLength": 32,
          "maxLength": 32
        },
        "qdp_run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "video_id": {
          "type": "integer",
          "minimum": 1
        },
        "analysis_group": {
          "const": "A"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "event_payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "preferred_media_asset_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "project_id",
        "qdp_run_id",
        "video_id",
        "analysis_group",
        "input_sha256"
      ]
    }
  }
}
