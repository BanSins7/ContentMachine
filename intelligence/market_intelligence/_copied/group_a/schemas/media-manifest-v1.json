{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified GA media manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ga-media-manifest/v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$",
      "minLength": 32,
      "maxLength": 32
    },
    "qdp_run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "video_id": {
      "type": "integer",
      "minimum": 1
    },
    "qdp_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "content_kind": {
      "enum": [
        "video",
        "slideshow_video",
        "photo_carousel",
        "mixed_carousel",
        "image_post"
      ]
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    },
    "source_policy_version_id": {
      "type": "integer",
      "minimum": 1
    },
    "verified_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "title": "Verified media item",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "image",
              "video"
            ]
          },
          "media_asset_id": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "byte_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483648
          },
          "verified_local_path_ref": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}:[A-Za-z0-9._:-]{1,200}$"
          },
          "duration_sec": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{3}$"
          }
        },
        "required": [
          "index",
          "kind",
          "media_asset_id",
          "sha256",
          "byte_size",
          "verified_local_path_ref"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "image"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "duration_sec"
                ]
              }
            }
          }
        ]
      }
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "qdp_run_id",
    "video_id",
    "qdp_input_sha256",
    "content_kind",
    "source_id",
    "source_policy_version_id",
    "verified_at",
    "items",
    "manifest_sha256"
  ],
  "$id": "https://contentmachine.local/schemas/group-a/media-manifest-v1.json"
}
