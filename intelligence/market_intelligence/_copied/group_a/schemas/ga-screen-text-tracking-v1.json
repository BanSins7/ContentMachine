{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentmachine.local/schemas/group-a/ga-screen-text-tracking-v1.json",
  "title": "GA13 sparse text recurrences, per-frame evidence only, no invented A003 text intervals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method_version",
    "source_media_sha256",
    "frame_manifest_sha256",
    "ocr_observation_sha256",
    "project_id",
    "run_id",
    "source_duration_sec",
    "status",
    "sampling_truth",
    "temporal_coverage",
    "full_video_text_absence",
    "continuous_intervals_verified",
    "first_text_observed_sec",
    "first_text_true_onset_sec",
    "sampled_screen_word_count",
    "video_wide_screen_word_count",
    "counts",
    "tracks",
    "a003_screen_text_projection",
    "a003_publication_state",
    "config",
    "observation_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "ga-screen-text-tracking/v1"
    },
    "method_version": {
      "const": "group-a-screen-text-tracking-v1"
    },
    "source_media_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "frame_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ocr_observation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_duration_sec": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
    },
    "status": {
      "enum": [
        "partial",
        "unavailable"
      ]
    },
    "sampling_truth": {
      "const": "sparse_instants_only"
    },
    "temporal_coverage": {
      "const": "unknown"
    },
    "full_video_text_absence": {
      "const": "unknown"
    },
    "continuous_intervals_verified": {
      "const": false
    },
    "first_text_observed_sec": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_text_true_onset_sec": {
      "type": "null"
    },
    "sampled_screen_word_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "video_wide_screen_word_count": {
      "type": "null"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampled_frames",
        "recognized_line_observations",
        "duplicate_lines_suppressed",
        "distinct_occurrences",
        "observed_frame_instants"
      ],
      "properties": {
        "sampled_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48
        },
        "recognized_line_observations": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_lines_suppressed": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_occurrences": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4000
        },
        "observed_frame_instants": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48
        }
      }
    },
    "tracks": {
      "type": "array",
      "maxItems": 4000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "track_id",
          "text",
          "normalized_text",
          "word_count",
          "observation_count",
          "first_observed_sec",
          "last_observed_sec",
          "sampled_span_sec",
          "time_semantics",
          "continuity_verified",
          "start_time_bound",
          "end_time_bound",
          "intervening_coverage",
          "closure_reason",
          "observations"
        ],
        "properties": {
          "track_id": {
            "type": "string",
            "pattern": "^t[0-9]{4}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "normalized_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "word_count": {
            "type": "integer",
            "minimum": 1
          },
          "observation_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 48
          },
          "first_observed_sec": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
          },
          "last_observed_sec": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
          },
          "sampled_span_sec": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
          },
          "time_semantics": {
            "const": "observed_instants_only"
          },
          "continuity_verified": {
            "const": false
          },
          "start_time_bound": {
            "const": "at_or_before_first_observed"
          },
          "end_time_bound": {
            "const": "at_or_after_last_observed"
          },
          "intervening_coverage": {
            "enum": [
              "unknown",
              "not_applicable"
            ]
          },
          "closure_reason": {
            "enum": [
              "absent_in_sampled_frame",
              "unverified_language_gap",
              "sample_gap_exceeded",
              "ocr_gap_unknown",
              "video_sampling_ended"
            ]
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 48,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "normalized_text",
                "bbox",
                "confidence_pct",
                "line_ref",
                "word_count",
                "frame_width",
                "frame_height",
                "frame_ref",
                "sample_index",
                "observed_sec"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "normalized_text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "bbox": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "confidence_pct": {
                  "type": "string",
                  "pattern": "^(?:100\\.00|(?:[0-9]|[1-9][0-9])\\.[0-9]{2})$"
                },
                "line_ref": {
                  "type": "string",
                  "pattern": "^l[0-9]{1,6}$"
                },
                "word_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "frame_width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 720
                },
                "frame_height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 720
                },
                "frame_ref": {
                  "type": "string",
                  "pattern": "^ga-frame:f[0-9]{3}-[a-f0-9]{64}$"
                },
                "sample_index": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 48
                },
                "observed_sec": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
                }
              }
            }
          }
        }
      }
    },
    "a003_screen_text_projection": {
      "type": "array",
      "maxItems": 0
    },
    "a003_publication_state": {
      "const": "blocked_unverified_continuity"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "similarity_min",
        "max_center_distance",
        "min_spatial_iou",
        "max_gap_sec",
        "min_chars_for_fuzzy",
        "merge_duplicate_iou",
        "max_tracked_lines"
      ],
      "properties": {
        "similarity_min": {
          "type": "string",
          "pattern": "^(?:0\\.[0-9]{1,3}|1(?:\\.0{1,3})?)$"
        },
        "max_center_distance": {
          "type": "string",
          "pattern": "^0\\.[0-9]{1,3}$"
        },
        "min_spatial_iou": {
          "type": "string",
          "pattern": "^0(?:\\.[0-9]{1,3})?$"
        },
        "max_gap_sec": {
          "type": "string",
          "pattern": "^[0-5](?:\\.[0-9]{1,3})?$"
        },
        "min_chars_for_fuzzy": {
          "type": "integer",
          "minimum": 3,
          "maximum": 30
        },
        "merge_duplicate_iou": {
          "type": "string",
          "pattern": "^(?:0\\.[0-9]{1,3}|1(?:\\.0{1,3})?)$"
        },
        "max_tracked_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        }
      }
    },
    "observation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tracks": {
            "maxItems": 0
          }
        },
        "required": [
          "tracks"
        ]
      },
      "then": {
        "properties": {
          "first_text_observed_sec": {
            "type": "null"
          },
          "sampled_screen_word_count": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tracks": {
            "minItems": 1
          }
        },
        "required": [
          "tracks"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "partial"
          },
          "first_text_observed_sec": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{3}$"
          },
          "sampled_screen_word_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unavailable"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "tracks": {
            "maxItems": 0
          },
          "counts": {
            "properties": {
              "observed_frame_instants": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ]
}
